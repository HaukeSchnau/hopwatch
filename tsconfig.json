{
  "extends": ["@schnau/tsconfig", "expo/tsconfig.base"],
  "compilerOptions": {
    "types": [],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@modules/*": ["./modules/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "android", "ios", "tools/oxlint/anti-slop", "expo-env.d.ts"]
}
