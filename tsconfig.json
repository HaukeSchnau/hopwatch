{
  "extends": [
    "@schnau/tsconfig",
    "expo/tsconfig.base"
  ],
  "compilerOptions": {
    "types": [],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@modules/*": [
        "./modules/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "tools/oxlint/anti-slop"
  ]
}
