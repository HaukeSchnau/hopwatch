<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the app's manifest by Gradle: taps from the notification and the widget, the
     home screen widget, and the Quick Settings tile. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="expo.modules.systemsurfaces.SurfaceReceiver"
            android:exported="false" />

        <receiver
            android:name="expo.modules.systemsurfaces.NowWidgetProvider"
            android:exported="true"
            android:label="@string/hopwatch_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hopwatch_now_widget" />
        </receiver>

        <service
            android:name="expo.modules.systemsurfaces.BackTileService"
            android:exported="true"
            android:icon="@drawable/hopwatch_tile"
            android:label="@string/hopwatch_tile_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
